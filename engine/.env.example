# 模型接入密钥（复制为 .env 并填入真实值；.env 不入库）
# 任意 OpenAI 兼容 API：DeepSeek / GPT / 通义 / Kimi / 智谱 / 硅基流动 / Ollama ...

DEEPSEEK_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx

# Embedding API Key（默认档为硅基流动 BAAI/bge-m3，openai_compat 接入）
# 申请：https://siliconflow.cn ；本地 local_bge / chroma_default 档无需此项
EMBEDDING_API_KEY=sk-xxxx

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 向量后端（仅 prod 档：APP_ENV=prod 时启用 Milvus，见 configs/prod.yaml）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
