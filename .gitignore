*.tsbuildinfo

# ─────────── 密钥（绝不入库） ───────────
.env
.env.*
!.env.example

# ─────────── 引擎运行时数据 ───────────
# 派生数据（向量库 / checkpoint / 日志，可随时重建）
engine/data/runtime/
*.sqlite
*.sqlite3
*.sqlite-*
# 蒸馏技能包（可由 distill 重建）
engine/data/skills/
# 用户创作数据（每本小说目录内另有独立 Git 仓库承担写作历史）
engine/data/novels/
engine/data/custom_skills/
engine/data/materials/
engine/data/learning/
engine/data/config/
# 工作区会话（墨师全域总控的对话记录，属用户数据）
engine/data/workspace/

# ─────────── 测试与临时产物 ───────────
e2e-shots/
smoke-output/
engine/smoke-reports/
engine/.smoke/
# 冒烟测试写出的临时文件（历史遗留：曾经把 e2e 日志写在仓库根内）
engine/e2e.txt
engine/smoke-state.json
engine/smoke-state.json
docs/_*.png
docs/step*.png

# ─────────── IDE / 系统 ───────────
.idea/
.vscode/
.DS_Store
Thumbs.db
