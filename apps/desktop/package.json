{
  "name": "@inkforge/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Inkforge 桌面壳：三栏工作台 + Python 引擎监督",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "check:word-target": "node scripts/check-word-target.mjs",
    "check:spawn-pick": "node scripts/check-spawn-pick.mjs",
    "check:renderer": "npm run check:word-target && npm run check:spawn-pick"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "naive-ui": "2.44.1",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@vitejs/plugin-vue": "6.0.7",
    "electron": "42.5.0",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "^7.1.5",
    "vue-tsc": "3.3.5"
  }
}
